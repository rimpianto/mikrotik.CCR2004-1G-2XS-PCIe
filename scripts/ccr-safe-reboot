#!/bin/bash
# ccr-safe-reboot v2 — riavvia la CCR2004-PCIe senza wedgare l'host
#
# Lezione del test v1 (26/9): il `echo remove` con nic0 port attivo di
# vmbr0 ha wedged il kernel. v2: quiesce atl1c PRIMA del remove.
#
# Sequenza:
#   1. route MGT via nic3 (via di controllo indipendente)
#   2. STACCA nic0 da vmbr0 e porta giu' le interfacce atl1c (driver quiescente)
#   3. remove delle 4 funzioni PCI
#   4. reboot scheda via MGT (ordine dato da fuori dal path della scheda)
#   5. attesa boot, rescan
#   6. re-attach nic0 a vmbr0 con MTU 1600
#
# Logging con timestamp su /var/log/ccr-safe-reboot.log per vedere
# ESATTAMENTE fino a dove arriva in caso di wedge.

set -u
CARD_IP=192.168.99.148
PCI="0000:01:00"
LOG=/var/log/ccr-safe-reboot.log

log() { echo "$(date +%T) [ccr-safe-reboot] $*" | tee -a "$LOG"; }

# --- 1. via di controllo via 10GbE ---
ip route replace 192.168.99.0/24 via 192.168.97.1 dev nic3
if ! timeout 8 ping -c 2 -W 3 $CARD_IP >/dev/null 2>&1; then
    log "ERRORE: $CARD_IP non raggiungibile via nic3, abort (nessun danno)"
    exit 1
fi
log "PASSO1 ok: scheda raggiungibile via nic3"

# --- 2. quiesce del driver: fuori dalla bridge, link down ---
ip link set nic0 nomaster 2>/dev/null
for n in nic0 nic1 nic2 nic5; do ip link set $n down 2>/dev/null; done
log "PASSO2 ok: nic0 staccata da vmbr0, interfacce atl1c down"
# sanity: l'host e' ancora vivo di sua iniziativa? (vmbr0 senza nic0)
ping -c 1 -W 2 192.168.97.1 >/dev/null 2>&1 && log "  host ancora vivo (vmbr0 ping ok)" || log "  NB: vmbr0 senza uplink (atteso se nic0 era l'unico port)"

# --- 3. remove funzioni PCI (driver quiescente) ---
sleep 3
for f in 0 1 2 3; do
    if [ -e /sys/bus/pci/devices/$PCI.$f ]; then
        echo 1 > /sys/bus/pci/devices/$PCI.$f/remove
        log "PASSO3: funzione $PCI.$f rimossa"
    else
        log "PASSO3: funzione $PCI.$f gia' assente"
    fi
done
log "PASSO3 ok: remove completato senza wedge"

# --- 4. reboot scheda ---
timeout 15 sshpass -p fede ssh -o StrictHostKeyChecking=no -o ConnectTimeout=8 \
    admin@$CARD_IP "/system reboot" 2>/dev/null && log "PASSO4: reboot ordinato" \
    || log "PASSO4: ssh chiuso al reboot (normale)"
sleep 5
timeout 8 ping -c 2 -W 3 $CARD_IP >/dev/null 2>&1 && log "  NB: scheda ancora su dopo 5s"

# --- 5. attesa boot + rescan ---
log "PASSO5: attesa 150s boot scheda..."
sleep 150
echo 1 > /sys/bus/pci/rescan
sleep 10
if [ -e /sys/bus/pci/devices/$PCI.0 ]; then
    log "PASSO5 ok: funzioni ri-enumerate"
else
    log "PASSO5: rescan#1 fallito, retry tra 60s"
    sleep 60
    echo 1 > /sys/bus/pci/rescan
    sleep 10
    [ -e /sys/bus/pci/devices/$PCI.0 ] && log "PASSO5 ok al secondo rescan" || log "PASSO5 FALLITO: scheda non ri-enumerata"
fi

# --- 6. re-attach a vmbr0 ---
ip link set nic0 mtu 1600 up
ip link set nic0 master vmbr0
sleep 5
ip -br link show nic0 | tee -a "$LOG"
ip -br addr show vmbr0 | tee -a "$LOG"
ping -c 2 -W 2 192.168.97.1 >/dev/null 2>&1 && log "PASSO6 ok: vmbr0 di nuovo operativa" || log "PASSO6: vmbr0 senza risposta gateway — controllare"
log "COMPLETATO — host sopravvissuto"
